# Copy this file to .env and change the values if needed.
# docker-compose.yml already sets these values for the containers.
# This file is mainly used when running ingestion.py, rag.py, or api.py locally.

# vLLM server
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-AWQ
VLLM_API_KEY=EMPTY

# Streamlit app
RAG_API_URL=http://rag-api:8080
